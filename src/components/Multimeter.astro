---
// Multimeter-Trainer: richtige Messart und Buchse für eine Situation wählen.
// Drehschalter und Buchsen sind direkt im Bild anklickbar, die Auswahllisten daneben bleiben für Tastatur und Screenreader.
import Station from './Station.astro';
interface Props { id: string; titel?: string; }
const { id, titel = 'Multimeter-Trainer' } = Astro.props;

const MODI = [
  { k: 'V⎓', t: 'Gleichspannung', w: -80 },
  { k: 'V~', t: 'Wechselspannung', w: -40 },
  { k: 'A⎓', t: 'Gleichstrom (mA)', w: 0 },
  { k: 'Ω', t: 'Widerstand', w: 40 },
  { k: '•)))', t: 'Durchgang (Piepser)', w: 80, wert: 'Durchgang' },
];
const CX = 160, CY = 230, R = 104;
const pos = (w: number, r: number) => ({ x: CX + r * Math.sin((w * Math.PI) / 180), y: CY - r * Math.cos((w * Math.PI) / 180) });
---
<Station id={id} titel={titel} art="Trainer">
  <div class="mm" data-kw-multimeter>
    <p class="situation" data-mm-situation></p>
    <div class="mm-aufbau">
      <svg viewBox="0 0 320 470" role="img" aria-label="Multimeter mit Drehschalter und drei Buchsen">
        <rect x="8" y="8" width="304" height="454" rx="30" class="gehaeuse" />
        <rect x="34" y="30" width="252" height="80" rx="8" class="display" />
        <text x="270" y="86" text-anchor="end" class="ziffern" data-mm-display>OFF</text>

        {MODI.map((m) => {
          const s = pos(m.w, 64), e = pos(m.w, 76), l = pos(m.w, R);
          return (
            <g class="modus" data-mm-modus={m.wert ?? m.k} tabindex="0" role="button" aria-label={`Drehschalter auf ${m.t}`}>
              <line x1={s.x} y1={s.y} x2={e.x} y2={e.y} class="strich" />
              <circle cx={l.x} cy={l.y} r="22" class="modus-flaeche" />
              <text x={l.x} y={l.y + 7} text-anchor="middle" class="modus-text">{m.k}</text>
            </g>
          );
        })}
        <circle cx={CX} cy={CY} r="58" class="dreh" />
        <g data-mm-zeiger class="zeiger-gruppe">
          <line x1={CX} y1={CY} x2={CX} y2={CY - 50} class="zeiger" />
          <circle cx={CX} cy={CY - 42} r="6" class="zeiger-punkt" />
        </g>
        <text x={CX} y={CY + 92} text-anchor="middle" class="hinweis-text">Tippe auf eine Messart</text>

        <g class="buchse-gruppe" data-mm-buchse="10A" tabindex="0" role="button" aria-label="Rote Leitung in Buchse 10A">
          <circle cx="70" cy="390" r="20" class="buchse" />
          <text x="70" y="440" text-anchor="middle" class="lbl">10A</text>
        </g>
        <g aria-hidden="true">
          <circle cx="160" cy="390" r="20" class="buchse com" />
          <text x="160" y="440" text-anchor="middle" class="lbl">COM</text>
          <text x="160" y="396" text-anchor="middle" class="steckt">schwarz</text>
        </g>
        <g class="buchse-gruppe" data-mm-buchse="VΩmA" tabindex="0" role="button" aria-label="Rote Leitung in Buchse V Ohm mA">
          <circle cx="250" cy="390" r="20" class="buchse" />
          <text x="250" y="440" text-anchor="middle" class="lbl">VΩmA</text>
        </g>
      </svg>

      <div class="steuer">
        <fieldset>
          <legend>Drehschalter</legend>
          {MODI.map((m) => <label><input type="radio" name={`modus-${id}`} value={m.wert ?? m.k} data-winkel={m.w} /> <b>{m.k}</b> {m.t}</label>)}
        </fieldset>
        <fieldset>
          <legend>Rote Messleitung in Buchse</legend>
          <label><input type="radio" name={`buchse-${id}`} value="VΩmA" /> <b>VΩmA</b> Spannung, Widerstand, kleine Ströme</label>
          <label><input type="radio" name={`buchse-${id}`} value="10A" /> <b>10A</b> nur große Ströme</label>
        </fieldset>
        <p class="leise klein">Die schwarze Leitung steckt immer in COM.</p>
        <button type="button" class="knopf" data-mm-pruefen>Einstellung prüfen</button>
      </div>
    </div>
  </div>
</Station>

<script>
  import { mischen, station } from '../scripts/station';
  const SITUATIONEN = [
    { text: 'Du willst die Spannung einer AA-Batterie messen.', modus: 'V⎓', buchse: 'VΩmA', anzeige: '1.58 V' },
    { text: 'Du willst den Wert eines einzelnen Widerstands messen, der nicht eingebaut ist.', modus: 'Ω', buchse: 'VΩmA', anzeige: '219 Ω' },
    { text: 'Du willst prüfen, ob ein Kabel innen gebrochen ist.', modus: 'Durchgang', buchse: 'VΩmA', anzeige: 'piep' },
    { text: 'Du willst den Strom durch eine LED messen (ein paar Milliampere).', modus: 'A⎓', buchse: 'VΩmA', anzeige: '5.02 mA' },
    { text: 'Du willst die Spannung deines Batteriehalters mit beiden AA-Zellen messen.', modus: 'V⎓', buchse: 'VΩmA', anzeige: '3.12 V' },
  ];
  const WARUM: Record<string, string> = {
    'V~': 'V~ ist für Wechselspannung. Batterien und alles in diesem Kurs liefern Gleichspannung (⎓).',
    'A⎓': 'Im Strommodus ist das Multimeter innen fast ein Kurzschluss. Parallel an eine Spannung gelegt, brennt die Sicherung durch.',
    'Ω': 'Widerstand misst man nur ohne Spannung. Das Gerät schickt dafür selbst einen kleinen Strom durch das Bauteil.',
    'Durchgang': 'Der Durchgangsprüfer sagt nur „verbunden oder nicht“, er misst keine Spannung und keinen Strom.',
    'V⎓': 'Gleichspannung passt hier nicht zur Aufgabe.',
  };
  const ANZEIGE: Record<string, string> = { 'V⎓': 'V⎓', 'V~': 'V~', 'A⎓': 'mA', 'Ω': 'Ω', 'Durchgang': '•)))' };

  document.querySelectorAll<HTMLElement>('[data-kw-multimeter]').forEach((box) => {
    const s = station(box.closest('[data-kw-check]') as HTMLElement);
    const fall = mischen(SITUATIONEN);
    let i = 0;
    const zeiger = box.querySelector<SVGGElement>('[data-mm-zeiger]')!;
    const disp = box.querySelector<SVGTextElement>('[data-mm-display]')!;
    const radioModus = (v: string) => box.querySelector<HTMLInputElement>(`input[name^=modus][value="${v}"]`)!;
    const radioBuchse = (v: string) => box.querySelector<HTMLInputElement>(`input[name^=buchse][value="${v}"]`)!;

    function modusSetzen(v: string | null) {
      const r = v ? radioModus(v) : null;
      if (r) r.checked = true;
      zeiger.style.transform = `rotate(${r ? r.dataset.winkel : 0}deg)`;
      disp.textContent = v ? ANZEIGE[v] : 'OFF';
      box.querySelectorAll<SVGGElement>('[data-mm-modus]').forEach((g) => g.classList.toggle('gewaehlt', g.dataset.mmModus === v));
    }
    function buchseSetzen(v: string | null) {
      if (v) radioBuchse(v).checked = true;
      box.querySelectorAll<SVGGElement>('[data-mm-buchse]').forEach((g) => g.classList.toggle('belegt', g.dataset.mmBuchse === v));
    }
    function zeigen() {
      box.querySelector('[data-mm-situation]')!.textContent = `Situation ${i + 1} von ${fall.length}: ${fall[i].text}`;
      box.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((x) => (x.checked = false));
      modusSetzen(null); buchseSetzen(null);
    }
    zeigen();

    const klickbar = (el: Element, f: () => void) => {
      el.addEventListener('click', f);
      el.addEventListener('keydown', (e) => { const k = (e as KeyboardEvent).key; if (k === 'Enter' || k === ' ') { e.preventDefault(); f(); } });
    };
    box.querySelectorAll<SVGGElement>('[data-mm-modus]').forEach((g) => klickbar(g, () => modusSetzen(g.dataset.mmModus!)));
    box.querySelectorAll<SVGGElement>('[data-mm-buchse]').forEach((g) => klickbar(g, () => buchseSetzen(g.dataset.mmBuchse!)));
    box.querySelectorAll<HTMLInputElement>('input[name^=modus]').forEach((x) => x.addEventListener('change', () => modusSetzen(x.value)));
    box.querySelectorAll<HTMLInputElement>('input[name^=buchse]').forEach((x) => x.addEventListener('change', () => buchseSetzen(x.value)));

    box.querySelector('[data-mm-pruefen]')!.addEventListener('click', () => {
      const f = fall[i];
      const modus = box.querySelector<HTMLInputElement>('input[name^=modus]:checked')?.value;
      const buchse = box.querySelector<HTMLInputElement>('input[name^=buchse]:checked')?.value;
      if (!modus) return s.melden('Stell zuerst den Drehschalter ein.', 'warnung');
      if (modus !== f.modus) return s.fehl(`Nicht passend. ${WARUM[modus]}`);
      if (!buchse) return s.melden('Wähle noch die Buchse für die rote Leitung.', 'warnung');
      if (buchse !== f.buchse) return s.fehl('Die 10A-Buchse ist nur für große Ströme über einige hundert Milliampere. Für alles andere gehört Rot in VΩmA.');
      disp.textContent = f.anzeige;
      i++;
      if (i >= fall.length) { s.bestehen('Alle Situationen richtig eingestellt.'); i = 0; return; }
      s.melden(`Richtig eingestellt. Das Gerät zeigt ${f.anzeige}. Nächste Situation.`, 'gut');
      setTimeout(zeigen, 1400);
    });
  });
</script>

<style>
  .situation { font-weight: 700; font-size: 1.1rem; }
  .mm-aufbau { display: grid; grid-template-columns: minmax(15rem, 19rem) 1fr; gap: 1.5rem; align-items: start; }
  @media (max-width: 640px) { .mm-aufbau { grid-template-columns: 1fr; } svg { max-width: 19rem; margin: 0 auto; } }
  svg { width: 100%; height: auto; display: block; }
  .gehaeuse { fill: #3b3b3b; stroke: #707070; stroke-width: 3; }
  .display { fill: #d8dcd2; stroke: #222; stroke-width: 3; }
  .ziffern { font-size: 40px; font-weight: 700; fill: #111; font-variant-numeric: tabular-nums; }
  .dreh { fill: #222; stroke: #8a8a8a; stroke-width: 3; }
  .zeiger { stroke: #f0f0f0; stroke-width: 8; stroke-linecap: round; }
  .zeiger-punkt { fill: var(--akzent); }
  .zeiger-gruppe { transform-box: view-box; transform-origin: 160px 230px; transition: transform 0.3s; }
  .strich { stroke: #9a9a9a; stroke-width: 3; }
  .modus { cursor: pointer; }
  .modus-flaeche { fill: #2a2a2a; stroke: #8a8a8a; stroke-width: 2; }
  .modus-text { fill: #f0f0f0; font-size: 19px; font-weight: 700; pointer-events: none; }
  .modus:hover .modus-flaeche, .modus:focus-visible .modus-flaeche { stroke: var(--akzent); stroke-width: 3; }
  .modus.gewaehlt .modus-flaeche { fill: var(--akzent); stroke: var(--akzent); }
  .modus.gewaehlt .modus-text { fill: #111; }
  .modus:focus, .modus:focus-visible { outline: none !important; }
  .hinweis-text { fill: #b0b0b0; font-size: 14px; }
  .buchse-gruppe { cursor: pointer; }
  .buchse { fill: #151515; stroke: #9a9a9a; stroke-width: 3; }
  .buchse.com { fill: #111; stroke: #d0d0d0; }
  .buchse-gruppe:hover .buchse, .buchse-gruppe:focus-visible .buchse { stroke: var(--akzent); }
  .buchse-gruppe:focus, .buchse-gruppe:focus-visible { outline: none !important; }
  .buchse-gruppe.belegt .buchse { fill: #f38ba8; stroke: #f38ba8; }
  .lbl { font-size: 17px; fill: #f0f0f0; font-weight: 700; }
  .steckt { font-size: 10px; fill: #bbb; }
  .steuer fieldset { border: 1px solid var(--flaeche); border-radius: var(--radius-klein); margin: 0 0 0.9rem; padding: 0.6rem 0.9rem; }
  .steuer legend { font-weight: 700; padding: 0 0.3rem; }
  .steuer label { display: block; padding: 0.3rem 0; cursor: pointer; }
  .steuer input { accent-color: var(--akzent); width: 1rem; height: 1rem; vertical-align: -0.15rem; margin-right: 0.3rem; }
</style>
