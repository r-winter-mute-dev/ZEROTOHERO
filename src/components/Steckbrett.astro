---
// Steckbrett-Trainer: Sind zwei markierte Löcher verbunden?
import Station from './Station.astro';
interface Props { id: string; titel?: string; anzahl?: number; }
const { id, titel = 'Steckbrett-Trainer', anzahl = 6 } = Astro.props;

const SPALTEN = 12;
const ZEILEN = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j'];
const x = (s: number) => 60 + s * 36;
const y = (z: number) => 70 + z * 26 + (z >= 5 ? 26 : 0);
---
<Station id={id} titel={titel} art="Trainer">
  <div class="steckbrett" data-kw-steckbrett data-anzahl={anzahl}>
    <svg viewBox="0 0 540 400" role="img" aria-label="Steckbrett mit nummerierten Spalten, Zeilen a bis j und zwei Versorgungsschienen">
      <rect x="20" y="10" width="500" height="380" rx="10" class="brett" />
      <rect x="40" y="198" width="460" height="14" class="rinne" />
      {/* Versorgungsschienen oben (+/−) und unten (+/−) */}
      {[24, 40, 360, 376].map((ry, i) => (
        <g>
          <line x1="50" x2="490" y1={ry} y2={ry} class={i % 2 === 0 ? 'schiene-plus' : 'schiene-minus'} />
          {Array.from({ length: SPALTEN }, (_, s) => (
            <rect class="loch" data-loch={`s${i}-${s}`} x={x(s) + 0} y={ry - 5} width="10" height="10" rx="1.5" />
          ))}
        </g>
      ))}
      <text x="32" y="29" class="z">+</text><text x="32" y="45" class="z">−</text>
      <text x="32" y="365" class="z">+</text><text x="32" y="381" class="z">−</text>
      {Array.from({ length: SPALTEN }, (_, s) => <text x={x(s) + 5} y="62" class="z" text-anchor="middle">{s + 1}</text>)}
      {ZEILEN.map((z, zi) => (
        <g>
          <text x="40" y={y(zi) + 9} class="z" text-anchor="middle">{z}</text>
          {Array.from({ length: SPALTEN }, (_, s) => (
            <rect class="loch" data-loch={`${z}${s + 1}`} x={x(s)} y={y(zi)} width="10" height="10" rx="1.5" />
          ))}
        </g>
      ))}
    </svg>
    <p class="frage" data-sb-frage></p>
    <div class="knoepfe">
      <button type="button" class="knopf" data-sb-antwort="ja">Verbunden</button>
      <button type="button" class="knopf zweit" data-sb-antwort="nein">Nicht verbunden</button>
    </div>
    <p class="leise klein" data-sb-stand></p>
  </div>
</Station>

<script>
  import { mischen, station } from '../scripts/station';
  const Z = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j'];
  const r = (n: number) => Math.floor(Math.random() * n);
  const loch = (z: number, s: number) => ({ id: `${Z[z]}${s + 1}`, name: `${Z[z]}${s + 1}` });

  // Erzeugt Fragen mit passender Erklärung.
  function frage(art: number) {
    const s = r(12);
    switch (art) {
      case 0: { const a = r(5); let b = r(5); if (b === a) b = (a + 2) % 5; return { l: [loch(a, s), loch(b, s)], ja: true, warum: 'In einer Spalte sind die fünf Löcher a–e miteinander verbunden.' }; }
      case 1: { const a = 5 + r(5); let b = 5 + r(5); if (b === a) b = 5 + ((a - 5 + 2) % 5); return { l: [loch(a, s), loch(b, s)], ja: true, warum: 'Auch f–j sind in jeder Spalte miteinander verbunden.' }; }
      case 2: return { l: [loch(r(5), s), loch(5 + r(5), s)], ja: false, warum: 'Die Mittelrinne trennt a–e von f–j.' };
      case 3: { const z = r(10); let t = r(12); if (t === s) t = (s + 3) % 12; return { l: [loch(z, s), loch(z, t)], ja: false, warum: 'Löcher in derselben Zeile, aber in verschiedenen Spalten, sind nicht verbunden.' }; }
      case 4: { const sch = r(2) * 2 + r(2); let t = r(12); if (t === s) t = (s + 4) % 12; return { l: [{ id: `s${sch}-${s}`, name: 'Schiene' }, { id: `s${sch}-${t}`, name: 'Schiene' }], ja: true, warum: 'Eine Versorgungsschiene ist der Länge nach verbunden. Achtung: Bei manchen Steckbrettern ist sie in der Mitte geteilt. Prüfe das an deinem Brett mit dem Multimeter.' }; }
      default: { const oben = r(2) === 0; return { l: [{ id: `s${oben ? 0 : 2}-${s}`, name: 'Plus' }, { id: `s${oben ? 1 : 3}-${s}`, name: 'Minus' }], ja: false, warum: 'Plus- und Minus-Schiene sind voneinander getrennt.' }; }
    }
  }

  document.querySelectorAll<HTMLElement>('[data-kw-steckbrett]').forEach((box) => {
    const s = station(box.closest('[data-kw-check]') as HTMLElement);
    const anzahl = Number(box.dataset.anzahl);
    let fragen = mischen([0, 1, 2, 3, 4, 5]).slice(0, anzahl).map(frage);
    let i = 0, fehler = 0;

    function zeigen() {
      box.querySelectorAll('.markiert').forEach((e) => e.classList.remove('markiert'));
      const f = fragen[i];
      f.l.forEach((l) => box.querySelector(`[data-loch="${l.id}"]`)?.classList.add('markiert'));
      const name = (l: { id: string; name: string }) => (l.name === 'Schiene' || l.name === 'Plus' || l.name === 'Minus' ? `das markierte Loch auf der Schiene` : l.name);
      box.querySelector('[data-sb-frage]')!.textContent = `Frage ${i + 1} von ${fragen.length}: Sind ${name(f.l[0])} und ${name(f.l[1])} miteinander verbunden?`;
      box.querySelector('[data-sb-stand]')!.textContent = 'Die zwei Löcher sind im Bild farbig markiert.';
    }
    zeigen();

    box.querySelectorAll<HTMLButtonElement>('[data-sb-antwort]').forEach((b) => b.addEventListener('click', () => {
      const f = fragen[i];
      const ok = (b.dataset.sbAntwort === 'ja') === f.ja;
      if (!ok) { fehler++; s.fehl(`Falsch. ${f.warum}`); return; }
      i++;
      if (i >= fragen.length) {
        if (fehler === 0) { s.bestehen('Alles richtig. Du kennst dein Steckbrett.'); }
        else { s.melden(`Geschafft, aber mit ${fehler} Fehler(n). Zum Bestehen brauchst du eine Runde ohne Fehler. Neue Runde startet.`, 'warnung'); }
        fragen = mischen([0, 1, 2, 3, 4, 5]).slice(0, anzahl).map(frage); i = 0; fehler = 0;
      } else s.melden(`Richtig. ${f.warum}`, 'gut');
      zeigen();
    }));
  });
</script>

<style>
  svg { width: 100%; max-width: 34rem; height: auto; display: block; }
  .brett { fill: #d9d9d9; }
  .rinne { fill: #bdbdbd; }
  .loch { fill: #3d3d3d; }
  :global(.steckbrett .loch.markiert) { fill: var(--akzent); stroke: #8a5fc2; stroke-width: 2; }
  .z { fill: #555555; font-size: 12px; }
  .schiene-plus { stroke: #c0392b; stroke-width: 1.5; }
  .schiene-minus { stroke: #2c5aa0; stroke-width: 1.5; }
  .frage { font-weight: 700; margin-top: 1rem; }
  .knoepfe { display: flex; gap: 0.6rem; flex-wrap: wrap; }
</style>
