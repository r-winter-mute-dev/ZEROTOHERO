---
// Der Fahrroboter als Bestückungsplan von oben (vorn ist oben). Jedes Teil gehört zu einem Akt von Kampagne 2.
// Zustände wie bei der Klingel: gesperrt (gestrichelt), aktiv, simuliert, real.
// ESP32 und Akku kommen aus Kampagne 1 und sind nur angedeutet.
import { FAHRROBOTER } from '../data/kampagne';
interface Props { legende?: boolean; }
const { legende = true } = Astro.props;
const akt = (teil: string) => FAHRROBOTER.find((a) => a.teil === teil)!;
const L = (teil: string, x: number, y: number, anchor = 'start') => ({ teil, x, y, anchor, a: akt(teil) });
const LABELS = [
  L('werkbank', 96, 506), L('motor', 210, 357, 'middle'), L('fahrwerk', 72, 380, 'middle'),
  L('augen', 210, 46, 'middle'), L('regler', 210, 214, 'middle'), L('tacho', 104, 266, 'middle'), L('funk', 322, 196, 'middle'),
];
---
<figure class="roboter" data-kw-roboter>
  <svg viewBox="0 0 420 560" role="img" aria-labelledby="roboter-titel">
    <title id="roboter-titel">Dein Fahrroboter. Jedes Teil füllt sich, wenn du den passenden Akt abschließt.</title>
    <g class="spuren" aria-hidden="true">
      <path d="M210 117V144M210 196V230M165 258H140V300M255 258H280V300M210 285V365" />
    </g>

    <g class="teil" data-teil="werkbank"><rect class="form" x="90" y="92" width="240" height="384" rx="32" /></g>

    <g class="teil" data-teil="fahrwerk">
      <rect class="form" x="52" y="282" width="32" height="80" rx="9" />
      <rect class="form" x="336" y="282" width="32" height="80" rx="9" />
      <path class="form" d="M60 296h16M60 310h16M60 324h16M60 338h16M60 352h16M344 296h16M344 310h16M344 324h16M344 338h16M344 352h16" />
      <circle class="form" cx="210" cy="446" r="15" />
      <circle class="form" cx="210" cy="446" r="5" />
    </g>

    <g class="teil" data-teil="tacho">
      <circle class="form" cx="102" cy="322" r="13" />
      <path class="form" d="M102 309v26M89 322h26M93 313l18 18M111 313l-18 18" />
      <circle class="form" cx="318" cy="322" r="13" />
      <path class="form" d="M318 309v26M305 322h26M309 313l18 18M327 313l-18 18" />
    </g>

    <g class="teil" data-teil="motor">
      <rect class="form" x="122" y="304" width="62" height="36" rx="5" />
      <rect class="form" x="236" y="304" width="62" height="36" rx="5" />
      <text x="153" y="327" text-anchor="middle" class="aufdruck">M</text>
      <text x="267" y="327" text-anchor="middle" class="aufdruck">M</text>
    </g>

    <g class="teil" data-teil="augen">
      <rect class="form" x="158" y="56" width="104" height="34" rx="6" />
      <circle class="form" cx="184" cy="73" r="12" />
      <circle class="form" cx="236" cy="73" r="12" />
      <rect class="form" x="168" y="102" width="20" height="14" rx="3" />
      <rect class="form" x="232" y="102" width="20" height="14" rx="3" />
    </g>

    <g class="teil" data-teil="regler">
      <path class="form" d="M236 170a26 26 0 1 1 -8 -19" />
      <path class="form" d="M228 141l1 11l-11 0" />
      <text x="210" y="175" text-anchor="middle" class="aufdruck">PID</text>
    </g>

    <g class="teil" data-teil="funk">
      <path class="form" d="M310 176a12 12 0 0 1 24 0M300 176a22 22 0 0 1 44 0M290 176a32 32 0 0 1 64 0" />
      <circle class="form" cx="322" cy="176" r="4" />
    </g>

    <g class="deko" aria-hidden="true">
      <rect x="165" y="232" width="90" height="52" rx="5" />
      <text x="210" y="263" text-anchor="middle">ESP32</text>
      <rect x="150" y="366" width="120" height="34" rx="9" />
      <text x="210" y="388" text-anchor="middle">18650</text>
    </g>

    {LABELS.map((l) => (
      <text class="druck" x={l.x} y={l.y} text-anchor={l.anchor} data-label={l.teil}>
        Akt {l.a.nr}<tspan class="druck-stand" data-stand={l.teil}></tspan>
      </text>
    ))}
  </svg>
  {legende && (
    <figcaption class="legende">
      <span><i class="l gesperrt"></i>gesperrt</span>
      <span><i class="l aktiv"></i>in Arbeit</span>
      <span><i class="l simuliert"></i>im Simulator</span>
      <span><i class="l real"></i>echt gebaut</span>
      <span><i class="l deko"></i>aus Kampagne 1</span>
    </figcaption>
  )}
</figure>

<script>
  import { FAHRROBOTER } from '../data/kampagne';
  import { beiAenderung, laden, teilZustand } from '../scripts/engine';
  function zeigen(erstes = false) {
    const z = laden();
    document.querySelectorAll<HTMLElement>('[data-kw-roboter]').forEach((fig) => {
      let reihe = 0;
      FAHRROBOTER.forEach((a) => {
        const t = teilZustand(a.teil, z);
        const g = fig.querySelector<SVGGElement>(`[data-teil="${a.teil}"]`);
        if (!g) return;
        g.classList.remove('gesperrt', 'aktiv', 'simuliert', 'real');
        g.classList.add(t.zustand);
        if (erstes && (t.zustand === 'real' || t.zustand === 'simuliert')) {
          g.style.setProperty('--verz', `${reihe++ * 140}ms`);
          g.classList.add('auftritt');
        }
        const stand = fig.querySelector(`[data-stand="${a.teil}"]`);
        if (stand) stand.textContent = t.zustand === 'real' ? ' fertig' : t.zustand === 'simuliert' ? ' simuliert' : t.fertig > 0 ? ` ${t.fertig}/${t.gesamt}` : '';
        fig.querySelector(`[data-label="${a.teil}"]`)?.classList.toggle('an', t.zustand !== 'gesperrt');
      });
    });
  }
  zeigen(true);
  beiAenderung(() => zeigen());
</script>

<style>
  .roboter { margin: 0; }
  svg { width: 100%; max-width: 26rem; height: auto; display: block; margin: 0 auto; overflow: visible; }
  .spuren path { fill: none; stroke: color-mix(in srgb, var(--akzent) 28%, transparent); stroke-width: 3; }
  .teil .form { fill: none; stroke: var(--leise-dunkel); stroke-width: 2; stroke-dasharray: 5 6; transition: fill 0.4s, stroke 0.4s; }
  .teil .aufdruck { fill: var(--leise-dunkel); font-size: 14px; font-weight: 700; }
  .teil.aktiv .form { stroke: var(--akzent); stroke-width: 2.5; }
  .teil.simuliert .form { stroke: var(--leise); stroke-dasharray: none; fill: rgba(163, 163, 163, 0.22); }
  .teil.real .form { stroke: var(--akzent-hell); stroke-dasharray: none; stroke-width: 2.5; fill: color-mix(in srgb, var(--akzent) 38%, transparent); }
  .teil.real .aufdruck, .teil.simuliert .aufdruck { fill: var(--text); }
  .teil[data-teil='werkbank'] .form { fill-opacity: 0.35; }
  .teil.real { filter: drop-shadow(0 0 6px color-mix(in srgb, var(--akzent-hell) 45%, transparent)); }
  .teil.auftritt { animation: einloeten 0.7s ease-out both; animation-delay: var(--verz); }
  @keyframes einloeten { from { opacity: 0.15; } 60% { opacity: 1; filter: drop-shadow(0 0 14px color-mix(in srgb, var(--akzent-hell) 90%, transparent)); } }
  .deko rect { fill: rgba(163, 163, 163, 0.08); stroke: var(--flaeche); stroke-width: 2; }
  .deko text { fill: var(--leise-dunkel); font-size: 13px; font-weight: 700; }
  .druck { fill: var(--leise-dunkel); font-size: 12.5px; }
  .druck.an { fill: var(--text); }
  .druck-stand { fill: var(--akzent-hell); }
  .legende { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; justify-content: center; font-size: 0.9rem; color: var(--leise); margin-top: 0.8rem; }
  .l { display: inline-block; width: 0.9rem; height: 0.9rem; border-radius: 3px; margin-right: 0.35rem; vertical-align: -0.1rem; border: 2px solid; }
  .l.gesperrt { border-color: var(--leise-dunkel); border-style: dashed; }
  .l.aktiv { border-color: var(--akzent); border-style: dashed; }
  .l.simuliert { border-color: var(--leise); background: rgba(163, 163, 163, 0.3); }
  .l.real { border-color: var(--akzent-hell); background: color-mix(in srgb, var(--akzent) 50%, transparent); }
  .l.deko { border-color: var(--flaeche); background: rgba(163, 163, 163, 0.08); }
</style>
